# Copy this file to .env and fill in your values

# ── Logging ──────────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Models ───────────────────────────────────────────────────────────────────
# Path to YOLO model files (relative to app root or absolute)
PPE_MODEL_PATH=DevSynapse-hybrid.pt
FIRE_MODEL_PATH=firedetect-11x.pt

# ── Storage ──────────────────────────────────────────────────────────────────
# How many days to keep violation images and DB records (0 = keep forever)
IMAGE_RETENTION_DAYS=30

# Set to true to also save raw (unannotated) frames alongside violations.
# WARNING: Generates significant disk usage. Off by default.
SAVE_RAW_FRAMES=false

# Directory for raw frames when SAVE_RAW_FRAMES=true
RAW_FRAMES_DIR=dummy

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Group/channel ID (negative number, e.g. -1001234567890)
# or user ID for direct messages (positive number)
# Add @userinfobot to your group to find the chat ID
TELEGRAM_CHAT_ID=

# Only send notifications for detections with confidence >= this value (0.0 - 1.0)
TELEGRAM_CONFIDENCE_THRESHOLD=0.85

# Batch window in seconds — all violations within this window are sent as one message
TELEGRAM_BATCH_INTERVAL_SECONDS=30
